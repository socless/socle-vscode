{
  "name": "socless",
  "displayName": "SoCLess (Chisel)",
  "description": "Live schematic view of Chisel designs, linked to the source.",
  "publisher": "socless",
  "version": "@VERSION@",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/e-ban/SoCless"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": ["Programming Languages", "Visualization"],
  "main": "./out/extension.js",
  "activationEvents": ["onLanguage:scala"],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "SoCLess runs your build (Mill) and tests, which requires a trusted workspace."
    }
  },
  "contributes": {
    "languages": [
      {
        "id": "scala",
        "aliases": ["Scala"],
        "extensions": [".scala"]
      }
    ],
    "configuration": {
      "title": "SoCLess",
      "properties": {
        "socless.javaPath": {
          "type": "string",
          "default": "",
          "scope": "machine-overridable",
          "description": "Java 21+ executable that runs the SoCLess language server. Empty: $JAVA_HOME/bin/java, else java on the PATH."
        },
        "socless.serverJar": {
          "type": "string",
          "default": "",
          "scope": "machine-overridable",
          "description": "SoCLess language server jar. Empty: the one bundled with the extension."
        },
        "socless.waveFlag": {
          "type": "string",
          "default": "emitVcd",
          "scope": "machine-overridable",
          "description": "ChiselSim option that turns waveforms on for Simulate, passed to ScalaTest as -D<flag>=1 (emitVcd is ChiselSim's; a project may define its own, such as emitFst)."
        },
        "socless.surferCommand": {
          "type": "string",
          "default": "surfer",
          "scope": "machine-overridable",
          "description": "Waveform viewer that Simulate starts on the trace (an executable, run as <command> <trace>)."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "socless",
          "title": "SoCLess",
          "icon": "media/socless.svg"
        }
      ]
    },
    "views": {
      "socless": [
        { "id": "socless.tests", "name": "Tests" },
        { "id": "socless.hierarchy", "name": "Hierarchy" },
        { "id": "socless.details", "name": "Details" }
      ]
    },
    "commands": [
      {
        "command": "socless.showPanel",
        "title": "SoCLess: Show design panel",
        "icon": "$(preview)"
      },
      {
        "command": "socless.refreshTests",
        "title": "SoCLess: Refresh tests",
        "icon": "$(refresh)"
      },
      {
        "command": "socless.openSettings",
        "title": "SoCLess: Open settings",
        "icon": "$(gear)"
      },
      {
        "command": "socless.viewDesignItem",
        "title": "View design",
        "icon": "$(eye)"
      },
      {
        "command": "socless.simulateItem",
        "title": "Simulate",
        "icon": "$(play)"
      },
      {
        "command": "socless._panelUrl",
        "title": "SoCLess: Panel URL (test only)"
      },
      {
        "command": "socless._views",
        "title": "SoCLess: Side panel rows (test only)"
      },
      {
        "command": "socless._openTest",
        "title": "SoCLess: Open test"
      },
      {
        "command": "socless._openHierarchy",
        "title": "SoCLess: Show in the schematic"
      }
    ],
    "menus": {
      "commandPalette": [
        { "command": "socless._panelUrl", "when": "false" },
        { "command": "socless._views", "when": "false" },
        { "command": "socless._openTest", "when": "false" },
        { "command": "socless._openHierarchy", "when": "false" },
        { "command": "socless.viewDesignItem", "when": "false" },
        { "command": "socless.simulateItem", "when": "false" }
      ],
      "view/title": [
        { "command": "socless.refreshTests", "when": "view == socless.tests", "group": "navigation@1" },
        { "command": "socless.showPanel", "when": "view == socless.tests", "group": "navigation@2" },
        { "command": "socless.openSettings", "when": "view == socless.tests", "group": "navigation@3" }
      ],
      "view/item/context": [
        { "command": "socless.viewDesignItem", "when": "view == socless.tests && viewItem == test", "group": "inline@1" },
        { "command": "socless.simulateItem", "when": "view == socless.tests && viewItem == test", "group": "inline@2" }
      ]
    }
  },
  "dependencies": {
    "vscode-languageclient": "@VSCODE_LANGUAGECLIENT@"
  }
}
